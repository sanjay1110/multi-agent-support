# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# --- LLM -------------------------------------------------------------------
# auto = use Claude if ANTHROPIC_API_KEY is set, otherwise the offline mock
LLM_MODE=auto
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_ROUTER_MODEL=claude-haiku-5-5
MAX_TOKENS=1024
# USD per 1M tokens, used for cost metrics. Set these to your models' current prices.
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0
ROUTER_PRICE_INPUT_PER_MTOK=1.0
ROUTER_PRICE_OUTPUT_PER_MTOK=5.0

# --- Security --------------------------------------------------------------
# Token for approver/admin endpoints. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me
# Shared key required (X-Access-Token header) to use /v1/chat. Leave empty only for
# local-only use; ALWAYS set it before exposing the API (LAN, tunnel, cloud).
ACCESS_TOKEN=

# --- Runtime ---------------------------------------------------------------
DATA_DIR=data
LOG_LEVEL=INFO
LOG_FILE=ops/logs/app.jsonl
SIM_TODAY=2026-11-17
SIM_LATENCY_MS=0
MAX_AGENT_STEPS=6

# --- Observability (optional) -----------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_CONSOLE=1
